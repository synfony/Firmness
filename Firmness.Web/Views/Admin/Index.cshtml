@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mt-4">
    <h1 class="m-0">Dashboard</h1>
    <a asp-controller="Import" asp-action="Index" class="btn btn-primary">Importar Datos</a>
</div>
<p class="lead mt-2">Métricas principales del sistema.</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">Total de Productos</div>
            <div class="card-body">
                <h5 class="card-title">@Model.TotalProducts</h5>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Total de Clientes</div>
            <div class="card-body">
                <h5 class="card-title">@Model.TotalClients</h5>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info mb-3">
            <div class="card-header">Total de Ventas</div>
            <div class="card-body">
                <h5 class="card-title">@Model.TotalSales</h5>
            </div>
        </div>
    </div>
</div>
