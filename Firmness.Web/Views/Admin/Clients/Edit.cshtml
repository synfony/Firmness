@model Firmness.Web.Models.Client

@{
    ViewData["Title"] = "Editar Cliente";
}

<h2 class="mb-4">Editar Cliente</h2>

<form asp-action="Edit" asp-controller="CrudClients" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PersonType" />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Apellido</label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Documento</label>
        <input asp-for="DocumentId" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dirección</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Teléfono</label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Historial de Compras</label>
        <textarea asp-for="PurchaseHistory" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>