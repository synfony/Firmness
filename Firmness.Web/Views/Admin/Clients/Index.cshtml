@model IEnumerable<Firmness.Web.Models.Client>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0">Lista de Clientes</h2>
    <a asp-controller="Export" asp-action="ExportClientsToExcel" class="btn btn-success">Exportar a Excel</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Nombre</th>
        <th>Documento</th>
        <th>Dirección</th>
        <th>Teléfono</th>
        <th>Historial de Compras</th>
        <th>Acciones</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.FirstName @c.LastName</td>
            <td>@c.DocumentId</td>
            <td>@c.Address</td>
            <td>@c.PhoneNumber</td>
            <td>@c.PurchaseHistory</td>

            <td>
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-sm">Editar</a>
                <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-danger btn-sm">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
