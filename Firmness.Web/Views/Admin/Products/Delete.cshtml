@model Firmness.Web.Models.Product

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h2 class="mb-4 text-danger">¿Eliminar Producto?</h2>

<div class="alert alert-warning">
    ¿Seguro que deseas eliminar <strong>@Model.Name</strong>?
</div>

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" width="150" class="rounded border" />
    }
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
