@model IEnumerable<Firmness.Core.Models.Product>

@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0">Productos</h2>
    <div>
        <a asp-action="Create" class="btn btn-primary">Crear nuevo producto</a>
        <a asp-controller="Export" asp-action="ExportProductsToExcel" class="btn btn-success">Exportar a Excel</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Imagen</th>
        <th>Nombre</th>
        <th>Precio</th>
        <th>Stock</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" width="80" class="rounded border" />
                }
            </td>
            <td>@item.Name</td>
            <td>$@item.Price</td>
            <td>@item.Stock</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
