@model IEnumerable<Firmness.Web.Models.Product>

@{
    ViewData["Title"] = "Productos";
}

<h2 class="mb-4">Productos</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Crear nuevo producto</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Imagen</th>
        <th>Nombre</th>
        <th>Precio</th>
        <th>Stock</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" width="80" class="rounded border" />
                }
            </td>
            <td>@item.Name</td>
            <td>$@item.Price</td>
            <td>@item.Stock</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>