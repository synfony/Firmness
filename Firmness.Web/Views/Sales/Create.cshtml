@model Firmness.Web.Models.Sale

@{
    ViewData["Title"] = "Crear Venta";
}

<h2>Crear Venta</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="ClientId" class="control-label">Cliente</label>
        <select asp-for="ClientId" class="form-control" asp-items="@(new SelectList(ViewBag.Clients, "Id", "FirstName"))"></select>
    </div>

    <h4>Productos</h4>
    <div id="sale-details">
        <!-- Product rows will be added here -->
    </div>

    <button type="button" id="add-product" class="btn btn-secondary mt-2">Añadir Producto</button>
    <hr />
    <button type="submit" class="btn btn-primary">Guardar Venta</button>
</form>

@section Scripts {
    <script>
        document.getElementById('add-product').addEventListener('click', function () {
            var detailsContainer = document.getElementById('sale-details');
            var index = detailsContainer.children.length;
            var newRow = `
                <div class="row mb-2">
                    <div class="col">
                        <select name="SaleDetails[${index}].ProductId" class="form-control" asp-items="@(new SelectList(ViewBag.Products, "Id", "Name"))"></select>
                    </div>
                    <div class="col">
                        <input type="number" name="SaleDetails[${index}].Quantity" class="form-control" placeholder="Cantidad" />
                    </div>
                    <div class="col">
                        <input type="number" step="0.01" name="SaleDetails[${index}].UnitPrice" class="form-control" placeholder="Precio Unitario" />
                    </div>
                </div>`;
            detailsContainer.insertAdjacentHTML('beforeend', newRow);
        });
    </script>
}
